# Copia este fichero como .env y cambia los valores (el .env no se sube a GitHub)
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=airtortilla
POSTGRES_USER=airtortilla
POSTGRES_PASSWORD=cambia-esta-contraseña

# Superusuario que se crea al arrancar por primera vez
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@airtortilla.local
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contraseña
